+# Devcontainer for MarketMindAI
+# - Node LTS (20)
+# - pnpm installed globally
+# - Git, Curl, and other basic tools available
+ARG VARIANT="20-bullseye"
+FROM mcr.microsoft.com/devcontainers/node:0-${VARIANT}
+
+# Avoid running as root for workspace files
+ARG USERNAME=node
+ARG USER_UID=1000
+ARG USER_GID=$USER_UID
+
+# Install system packages
+RUN apt-get update && \
+    apt-get install -y --no-install-recommends \
+      git \
+      lsb-release \
+      ca-certificates \
+      build-essential \
+      python3 \
+      curl && \
+    rm -rf /var/lib/apt/lists/*
+
+# Install pnpm globally
+RUN corepack enable && corepack prepare pnpm@latest --activate
+
+# Create workspace folder and set permissions
+RUN mkdir -p /workspace && chown ${USERNAME}:${USERNAME} /workspace
+
+WORKDIR /workspace
+
+# Ensure node user owns the workspace and will be used
+USER ${USERNAME}
+
+# Default shell for Codespaces
+SHELL ["/bin/bash", "-lc"]
+
+# Helpful message on container start
+RUN echo "MarketMindAI devcontainer ready. Use pnpm to install deps."
+
+# Expose typical dev ports (no effect in Codespaces but useful)
+EXPOSE 3000 3001
+
